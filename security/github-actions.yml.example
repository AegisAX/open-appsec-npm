name: NPM security candidate
on:
  push:
    branches: [aegis/security-engine]
    paths: ['security/**', '.github/workflows/security-engine.yml']
  workflow_dispatch:
permissions:
  contents: read
jobs:
  candidate:
    runs-on: ubuntu-24.04
    timeout-minutes: 60
    steps:
      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6
        with:
          persist-credentials: false
      - name: Install Trivy
        working-directory: ${{ runner.temp }}
        run: |
          curl -fsSLO --retry 3 https://github.com/aquasecurity/trivy/releases/download/v0.76.2/trivy_0.76.2_Linux-64bit.tar.gz
          echo 'bc0fc726e017b8927a62b2d3531d7a84ee01769daf5c99ed866dced54089fdbf  trivy_0.76.2_Linux-64bit.tar.gz' | sha256sum -c -
          tar xzf trivy_0.76.2_Linux-64bit.tar.gz trivy
          echo "$PWD" >> "$GITHUB_PATH"
      - run: ./security/check-candidate.sh
